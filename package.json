{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --config desktop/builder.json --dir",
    "desktop:win": "npm run build && electron-builder --config desktop/builder.json --win nsis --x64 --publish never",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "oxlint": "^1.79.0",
    "playwright": "1.64.1",
    "vite": "^8.2.2"
  },
  "main": "desktop/main.mjs",
  "description": "Quest — cozy focus, tasks and desktop reminders",
  "author": "Quest"
}
